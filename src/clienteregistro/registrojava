public class MenuRegistro {
private Arraylist<Cliente> clientes;
private Arraylist<Mascota> mascotas;
private Scanner sc = new Scanner(System.in);

public Void mostrarMenu() {
    int opcion 
    do {
        System.out.println( "\n==Menu vetcare-registro==");
        System.out.println("1. Registrar Cliente");
        System.out.println("2. Registrar Mascota");
        System.out.println("3. Listar Clientes");
        System.out.println("4. Listar Mascotas");
        System.out.println("0. Salir");
        opcion = sc.nextInt();
        sc.nextLine(); // Limpiar el buffer de entrada

        switch (opcion); {

            case 1:
                registrarCliente();
                
            case 2:
                registrarMascota();
                
            case 3:
                listarClientes();
               
            case 4:
                listarMascotas();
                
            case 0:
                System.out.println("gracias por usar vetcare");
                
            default:
                System.out.println("Opcion invalida. Intente nuevamente.");
        }
    } while (opcion != 0);
}
private Void registrarCliente() {
    system.out.println("Ingrese el nombre del cliente:");
    String nombre = sc.nextLine();
    system.out.println("Ingrese el telefono del cliente:");
    String telefono = sc.nextLine();

    try {
        Cliente cliente = new Cliente(nombre, telefono);
        clientes.add(cliente);
        System.out.println("Cliente registrado exitosamente.");
    } catch (IllegalArgumentException e) {
        System.out.println("Error al registrar cliente: " + e.getMessage());
    }

    private Void registrarMascota() {
        System.out.println("Ingrese el nombre de la mascota:");
        String nombre = sc.nextLine();
        System.out.println("Ingrese la especie de la mascota:");
        String especie = sc.nextLine();
        System.out.println("Ingrese la edad de la mascota:");
        int edad = sc.nextInt();
        sc.nextLine();

        try {
            Mascota mascota = new Mascota(nombre, especie, edad);
            mascotas.add(mascota);
            System.out.println("Mascota registrada exitosamente.");
        } catch (IllegalArgumentException e) {
            System.out.println("Error al registrar mascota: " + e.getMessage());
        }
}
private Void listarClientes() {
    if (clientes.isEmpty()) {
        System.out.println("No hay clientes registrados.");
    } else {
        System.out.println("==Lista de Clientes Vetcare==");
        for (Cliente cliente : clientes) {
            System.out.println(cliente);
        }
    }
private Void listarMascotas() {
    if (mascotas.isEmpty()) {
        System.out.println("No hay mascotas registradas.");
    } else {
        System.out.println("==Lista de Mascotas Vetcare==");
        for (Mascota mascota : mascotas) {
            System.out.println(mascota);
        }
    }

    public static void main(String[] args) {
        MenuRegistro menu = new MenuRegistro();
        menu.mostrarMenu();
    }









}